# Server & Environment Configuration
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/iiit_mess_db
CLIENT_URL=http://localhost:5173,http://localhost:5000

# Authentication & JWT Security Tokens
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret_at_least_32_chars
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_secret_at_least_32_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_DOMAIN=
ALLOWED_STUDENT_EMAIL_DOMAIN=iiit-bh.ac.in

# Cloudinary Media Storage (optional for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Service Configuration (optional for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password

# Payment Gateway (mock)
PAYMENT_PROVIDER=mock
